#!/bin/bash

set -e

WEB_ROOT="/var/www/html"
HERIKA_LOG_DIR="${WEB_ROOT}/HerikaServer/log"

cd "$WEB_ROOT"
chown -R dwemer:www-data .

# Keep shared write access without making every repository file executable.
# Git tracks the owner's executable bit, so chmod -R 775 dirties every installed server.
find . -type d -exec chmod 2775 {} +
find . -type f -exec chmod ug+rw,o-rwx {} +

# Keep logs readable/writable across dwemer + www-data processes.
if [ -d "$HERIKA_LOG_DIR" ]; then
    find "$HERIKA_LOG_DIR" -type d -exec chmod 2775 {} \;
    find "$HERIKA_LOG_DIR" -type f -exec chmod ug+rw,o-rwx {} \;
fi
